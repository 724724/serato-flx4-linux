     return err;
 }
 
+#ifndef DRV_QUERYDEVICEINTERFACE
+#define DRV_QUERYDEVICEINTERFACE     (0x0800 + 12)  /* 0x80C */
+#define DRV_QUERYDEVICEINTERFACESIZE (0x0800 + 13)  /* 0x80D */
+#endif
+
+/* szPname 안에 "FLX4"가 들어있는지 (unixlib이라 wcsstr 못 씀) */
+static int match_flx4(const WCHAR *s)
+{
+    if (!s) return 0;
+    for (; *s; s++)
+        if (s[0]=='F' && s[1]=='L' && s[2]=='X' && s[3]=='4')
+            return 1;
+    return 0;
+}
