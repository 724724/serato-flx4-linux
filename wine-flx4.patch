+            u"{A5DCBF10-6530-11D2-901F-00C04FB951ED}";
+        DWORD len = 0, need;
+        while (flx4_if[len]) len++;
+        need = (len + 1) * sizeof(WCHAR);
+        if (params->dev_id < num_dests &&
+            match_flx4(dests[params->dev_id].caps.szPname))
+        {
+            if (params->msg == DRV_QUERYDEVICEINTERFACESIZE) {
+                *(DWORD *)params->param_1 = need;
+                *params->err = MMSYSERR_NOERROR;
+                fprintf(stderr, "[FLX4PATCH] OUT SIZE->%u\n", need);
+            } else {
+                memcpy((void *)params->param_1, flx4_if, need);
+                *params->err = MMSYSERR_NOERROR;
+                fprintf(stderr, "[FLX4PATCH] OUT COPY done, first=%04x len=%u p2=%Ix\n",
+                        ((WCHAR*)params->param_1)[0], need, (unsigned long)params->param_2);
+            }
+        } else
+            *params->err = MMSYSERR_NOTSUPPORTED;
+        break;
+    }
     default:
         TRACE("Unsupported message\n");
         *params->err = MMSYSERR_NOTSUPPORTED;
