+        if (params->dev_id < num_srcs &&
+            match_flx4(srcs[params->dev_id].caps.szPname))
+        {
+            if (params->msg == DRV_QUERYDEVICEINTERFACESIZE) {
+                *(DWORD *)params->param_1 = need;
+                *params->err = MMSYSERR_NOERROR;
+                fprintf(stderr, "[FLX4PATCH] IN SIZE->%u\n", need);
+            } else {
+                memcpy((void *)params->param_1, flx4_if, need);
+                *params->err = MMSYSERR_NOERROR;
+                fprintf(stderr, "[FLX4PATCH] IN COPY done, first=%04x len=%u p2=%Ix\n",
+                        ((WCHAR*)params->param_1)[0], need, (unsigned long)params->param_2);
+            }
+        } else
